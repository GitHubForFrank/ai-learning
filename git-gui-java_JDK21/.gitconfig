[http]
    # 为了解决报警 TLS certificate verification has been disabled!
    # 需要设置 sslVerify = true,同时指定CA证书
    sslCAInfo = C:\\workspaces\\SSL\\git-issue-to-20300223.cer
    sslVerify = false

    #proxy = http://cnpriproxy.aia.biz:10938
    #proxy = http://HKPriProxy.aia.biz:10938
    #proxy = http://SGPriProxy.aia.biz:10938

    # error: unable to rewind rpc post data - try increasing http.postBuffer --> 大概意思是http.postBuffer太小，需要设置更大的值，应该是我们项目中用到的第三方静态库有400多MB大小的单个.a文件。
    # Refer : https://www.cnblogs.com/gongchixin/articles/7509219.html
    # HTTP POST 缓冲区大小（字节），用于解决大文件推送时的超时问题
    postBuffer = 524288000
    # 低速限制阈值（字节/秒），0 表示禁用低速检测，允许任意慢的传输
    lowSpeedLimit = 0
    # 传输速度低于 lowSpeedLimit 多少秒后取消传输，999999 表示几乎不取消
    lowSpeedTime = 999999

# Git 用户信息配置，用于标识提交者身份
[user]
    name = Frank
    #email = 1126028327@qq.com
    email = Frank-ZQ.Kang@aia.com

# ========== 下面新增BC4对比工具配置 ==========
[diff]
    tool = bc4
[difftool "bc4"]
    path = D:\\workspaces\\develop_tools\\BeyondCompare\\Beyond Compare 5\\BCompare.exe
[difftool]
    prompt = false
# 可选：合并工具 mergetool（解决冲突时用BC4）
[merge]
    tool = bc4
[mergetool "bc4"]
    path = D:\\workspaces\\develop_tools\\BeyondCompare\\Beyond Compare 5\\BCompare.exe

[grep]
    # 启用扩展正则表达式支持，允许使用更强大的搜索模式（如 |、+、? 等元字符）
    extendedRegexp = true

[core]
    # 支持超过 260 字符的长文件路径（Windows 默认限制 260 字符）
    longpaths = true
    # 压缩级别：-1 表示使用 zlib 默认压缩，范围 0-9（0=不压缩，9=最大压缩）
    compression = -1
    # pack 文件的最大内存限制，用于优化大仓库性能（单位：m=MB）
    packedGitLimit = 2048m
    # Git 在打包时每次窗口操作的最大内存（单位：m=MB），影响 pack 文件的生成效率
    packedGitWindowSize = 2048m

    # 忽略文件权限变化（Windows 下无需跟踪权限，避免无意义的变更提示）
    filemode = false

    # autocrlf = true --> 表示要求git在提交时将crlf转换为lf，而在检出时将crlf转换为lf。
    # autocrlf = false --> 表示提交和检出代码时均不进行转换
    # autocrlf = input --> 表示在提交时将crlf转换为lf，而检出时不转换
    #autocrlf = true

    # safecrlf = true --> 表示拒绝提交包含混合换行符的文件
    # safecrlf = false --> 表示允许…
    # safecrlf = warn --> 表示警告
    #safecrlf = true


# 为了解决如下报错,添加 pack的配置
# error: unable to rewind rpc post data - try increasing http.postBuffer
# error: RPC failed; curl 56 OpenSSL SSL_read: SSL_ERROR_SYSCALL, errno 10054
# Refer : https://blog.csdn.net/shmily4992871/article/details/99439751
[pack]
    # deltaCacheSize: 打包时用于缓存 delta 数据的最大内存，单位可为 b/k/m/g，不加单位默认字节
    deltaCacheSize = 2048

    # packSizeLimit: 每个输出 pack 文件的最大体积，超出则拆分为多个 pack 文件
    packSizeLimit = 2048m

    # windowMemory: git pack-objects 每个线程可使用的最大内存窗口
    windowMemory = 200m

    # SizeLimit 不是有效的 git pack 配置键（正确键为 packSizeLimit），注释掉避免混淆
    # SizeLimit = 2048m

    # threads: pack 压缩时使用的线程数，0 表示自动检测 CPU 核心数
    threads = 60


# safe.directory: 信任指定目录的所有者检查，* 表示信任所有目录
# 适用场景：Windows 下多用户共享仓库、Docker 挂载卷或 CI 环境中避免 "dubious ownership" 报错
# 注意：* 会跳过所有目录的安全检查，生产环境建议填写具体路径
[safe]
    directory = *

# [filesystem] 由 Git 自动生成，用于缓存当前 JVM/文件系统的时间戳精度和竞态阈值，无需手动编辑
# 格式：[filesystem "JVM厂商|JVM版本|文件系统标识"]
#   timestampResolution: 文件系统时间戳的最小精度，Git 用它判断文件是否被修改（racy-git 问题）
#   minRacyThreshold:    最小竞态窗口，0 表示不额外放宽，完全依赖 timestampResolution
[filesystem "Oracle Corporation|1.8.0_40|483018026"]
    timestampResolution = 1001 microseconds
    minRacyThreshold = 0 nanoseconds
[filesystem "Oracle Corporation|1.8.0_131|-1270943953"]
    timestampResolution = 1001 microseconds
    minRacyThreshold = 0 nanoseconds
[filesystem "Oracle Corporation|1.8.0_131|1713440874"]
    timestampResolution = 1001 microseconds
    minRacyThreshold = 0 nanoseconds
[filesystem "Oracle Corporation|1.8.0_161|483018026"]
    timestampResolution = 10001 microseconds
    minRacyThreshold = 0 nanoseconds

# credential.helper = manager: 使用 Git Credential Manager (GCM)
# GCM 将账号密码安全存储在 Windows 凭据管理器中，支持 OAuth/MFA
[credential]
    helper = manager
# 针对特定服务器指定认证提供商，优先级高于全局 helper
# provider = bitbucket: 使用 Bitbucket OAuth 认证流程（支持 SSO/MFA）
[credential "https://aiahk-bitbucket.aiaazure.biz"]
    provider = bitbucket
# provider = generic: 使用通用用户名/密码认证（适用于非 Bitbucket/GitHub 的服务器）
[credential "https://gitee.com"]
    provider = generic
[credential "https://tss-bitbucket.aiaazure.biz"]
    provider = bitbucket